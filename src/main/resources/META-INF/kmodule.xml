    <kbase name="benchmarkKieBase" packages="com.drools.benchmark.rules">
        <!-- Stateful Session 供 S1、S2、S3 共享或独立会话场景创建。 -->
        <ksession name="benchmarkKieSession" type="stateful"/>
        <!-- Stateless Session 供 S4 并发 execute 场景创建。 -->
        <ksession name="benchmarkStatelessKieSession" type="stateless"/>
