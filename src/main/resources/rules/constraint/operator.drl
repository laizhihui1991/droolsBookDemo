package rules.constraint_operator

import com.test.drools.pojo.Person;
import com.test.drools.pojo.HouseholdRegister;
import java.util.List;

rule "person age gt 20"
	when
        $p:Person(age>20)
	then
end


rule "person name equals HouseholdRegister name"
	when
        $p:Person($name:name)
        $hr:HouseholdRegister(name==$name)
	then
       System.out.println("输出 Person的name与HouseholdRegister的name相同");
end

