rule "test Subtype"
	when
        $p:Person(name=="小编",age==30,householdRegister instanceof HouseholdRegister, householdRegister.name=="小编")
	then
	System.out.println("强制转换成的测试");
end


rule "test List"
	when
	    $l:List()
        $p:Person(name==$l[0])
	then
	System.out.println("集合中的第1个元素是： "+$p.getName());
end