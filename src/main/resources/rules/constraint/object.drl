rule "from person Behavior equals Behavior 1"
	when
       $p:Person($pb:behavior)
       $b:Behavior(run=="我要跑") from $pb
	then
       System.out.println("判断person中的behavior中的run等于我要跑");
end

rule "from person Behavior equals Behavior 2"
	when
       $p:Person()
       $b:Behavior(run=="我要跑") from $p.behavior
	then
       System.out.println("判断person中的behavior中的run等于我要跑");
end


rule "collect person list"
	when
        $al:ArrayList() from collect ($p:Person(name!="小编"))
	then
       System.out.println("检查贷款人不等于小编的集合人数："+$al.size());
end


rule "accumulate person max min age"
	when
       accumulate(Person($age:age),$min:min($age),$max:max($age))
    then
       System.out.println("最大的年龄是："+$max+"最小的年龄是： "+$min);
end




rule "accumulate person max min average age "
	when
      accumulate(
               Person($age:age);
               $min:min($age),
               $max:max($age),
               $avg:average($age)
      )
    then
    System.out.println("最小年龄 "+$min+" 最大年龄 "+$max);
end


rule "accumulate person "
	when
      accumulate(
               Person($age:age);
               $min:min($age),
               $max:max($age),
               $avg:average($age)
      )
    then
    System.out.println("最小年龄 "+$min+" 最大年龄 "+$max);
end

rule "accumulate action person age sum "
	when
      $sumAge:Integer() from accumulate(
                          Person($age:age),
                          init(Integer total=0;),
                          action(total+=$age;),
                          result(total)
                          )
    then
    System.out.println("贷款人年龄之合是 "+$sumAge);
end






























