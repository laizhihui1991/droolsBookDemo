package rules.constraint_object

import com.test.drools.pojo.Person;
import com.test.drools.pojo.HouseholdRegister;
import com.test.drools.pojo.Behavior;
import java.util.ArrayList;
import java.lang.Integer;

rule "Infix and person name equals HouseholdRegister name"
	when
        $p:Person($name:name) and
        $hr:HouseholdRegister( name == $name )
	then
       System.out.println("贷款人的姓名与户口本的姓名一致");
end

rule "Prefix and person name equals HouseholdRegister name "
	when
       (  and $p:Person($name:name)
        $hr:HouseholdRegister( name == $name )
       )
	then
       System.out.println("贷款人的姓名与户口本的姓名一致");
end


rule "Infix or person HouseholdRegister "
	when
        $p:Person() or
        $hr:HouseholdRegister()
	then
       System.out.println("贷款人存在或户口本存在");
end

rule "Prefix or person  HouseholdRegister "
	when
       (or $p:Person()
        $hr:HouseholdRegister()
       )
	then
       System.out.println("贷款人存在或户口本存在");
end

rule "exists person name equals 小编"
	when
       exists $p:Person(name=="小编")
	then
       System.out.println("贷款人姓名必须等于小编");
end

rule "not person name not equals 小柱"
	when
       not $p:Person(name=="小柱")
	then
       System.out.println("贷款人姓名中不存在小柱");
end

rule "forall person Behavior equals Behavior"
	when
       forall (
           $p:Person($name:name)
           $b:Behavior(this==$p.behavior)
       )
	then
       System.out.println("判断person中的behavior是否与Behavior是同一个对象");
end

