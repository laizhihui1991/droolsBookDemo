rule "test list"
	when
	    $p:Person(payChecks[0]=="工商银行")
	then
       System.out.println("贷款人的第一张工资卡是工商银行");
end

rule "test list get"
	when
	    $p:Person(payChecks.get(0)=="工商银行")
	then
       System.out.println("贷款人的第一张工资卡是工商银行");
end


rule "test Map"
	when
	    $p:Person(addressMap[name]=="北京")
	then
       System.out.println("贷款人： "+$p.getName()+" 在北京生活");
end

rule "test Map get"
	when
	    $p:Person(addressMap.get(name) == "北京" )
	then
      System.out.println("贷款人： "+$p.getName()+" 在北京生活");
end


rule "test Set"
	when
	    $p:Person()
	then
       System.out.println("贷款人： "+$p.getName()+" 曾经在"+$p.getClassNames().iterator().next()+"学习过");
end


rule "test list insert"
	when
	    $l:List()
	    eval($l[0]=="工商银行")
	then
       System.out.println("判断List的第一个元素等于工商银行");
end